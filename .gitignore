.DS_Store
.build/
.swiftpm/
*.xcuserdatad
xcuserdata/

# Oracle working tree — all regenerable, see PORT-STATUS.md "Reproduce".
oracle/upstream/
# Upstream .pth checkpoints — 60-300 MB, re-fetchable. Comment on its OWN line: a trailing
# one makes the pattern literal (the bug fixed in the HF-cache rule earlier today).
oracle/weights/
oracle/.venv/
# Any Hugging Face download cache (hf/, hf-cache/, hf-rt/, hf-roundtrip/).
# NOTE: the comment MUST be on its own line — '#' only starts a comment at the START of a
# line, so a trailing one made this pattern literal and it matched nothing.
oracle/hf*/
oracle/converted/
oracle/goldens/
oracle/__pycache__/

